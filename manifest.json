{
  "manifest_version": 3,
  "name": "Active Tab Highlighter",
  "version": "1.0",
  "description": "High-contrast tab strip theme plus a customisable indicator bar on the active page.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Active Tab Highlighter"
  },
  "theme": {
    "colors": {
      "frame":               [15,  15,  15 ],
      "toolbar":             [60,  60,  60 ],
      "tab_text":            [230, 230, 230],
      "tab_background_text": [140, 140, 140],
      "bookmark_text":       [210, 210, 210],
      "ntp_background":      [32,  32,  32 ],
      "ntp_text":            [230, 230, 230]
    }
  }
}
